// Zones owned by the platform. Both are dynamic: the webapp updates them through
// httpaas-dns and nsupdate, never by rewriting the files while named is running.
zone "cloud.local" {
	type primary;
	file "/var/lib/bind/db.cloud.local";
	update-policy local;
	// `httpaas-dns listar` needs AXFR to enumerate the zone; only the VM itself.
	allow-transfer { localhost; };
};

zone "10.168.192.in-addr.arpa" {
	type primary;
	file "/var/lib/bind/db.192.168.10";
	update-policy local;
};
